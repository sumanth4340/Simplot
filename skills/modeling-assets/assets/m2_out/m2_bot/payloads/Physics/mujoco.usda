"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "m2_bot"
{
    over "Physics"
    {
        def MjcActuator "shoulder_actuator"
        {
            uniform double mjc:forceRange:max = 10
            uniform double mjc:forceRange:min = -10
            custom rel mjc:target
            prepend rel mjc:target = </m2_bot/Physics/shoulder>
        }

        over "root_joint"
        {
        }

        over "shoulder" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
        }
    }

    over "Geometry"
    {
        over "base"
        {
            over "arm"
            {
                over "cylinder"
                {
                }

                over "cylinder_1"
                {
                }
            }

            over "box"
            {
            }

            over "box_1"
            {
            }
        }
    }
}

