<?xml version="1.0"?>
<robot name="m2_bot">
  <link name="base">
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
    <visual>
      <geometry><box size="1 1 0.5"/></geometry>
      <origin xyz="0 0 0.25"/>
    </visual>
    <collision>
      <geometry><box size="1 1 0.5"/></geometry>
      <origin xyz="0 0 0.25"/>
    </collision>
  </link>
  <link name="arm">
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.05" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.02"/>
    </inertial>
    <visual>
      <geometry><cylinder radius="0.1" length="1.0"/></geometry>
      <origin xyz="0 0 0.5"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.1" length="1.0"/></geometry>
      <origin xyz="0 0 0.5"/>
    </collision>
  </link>
  <joint name="shoulder" type="revolute">
    <parent link="base"/>
    <child link="arm"/>
    <origin xyz="0 0 0.5"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="1.0"/>
  </joint>
</robot>
