#usda 1.0
(
    defaultPrim = "Widget"
)

def Xform "Widget" (
    variants = {
        string config = "small"
    }
    prepend variantSets = "config"
)
{
    variantSet "config" = {
        "large" {
            def Cube "Box"
            {
                double size = 4
            }

        }
        "small" {
            def Cube "Box"
            {
                double size = 1
            }

        }
    }
}

