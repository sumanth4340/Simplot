#usda 1.0
(
    defaultPrim = "arm"
    metersPerUnit = 1
)

def Xform "arm" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI"]
)
{
    def Xform "base" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI"]
    )
    {
        def Cube "zero" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double size = 0
        }
    }

    def Xform "mirror"
    {
        float3 xformOp:scale = (-1, 1, 1)
        uniform token[] xformOpOrder = ["xformOp:scale"]

        def Cube "geom" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double size = 0.1
        }
    }

    def Xform "heavy" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:density = 500
        float physics:mass = 2
    }

    def PhysicsRevoluteJoint "jref"
    {
        custom float mjc:ref = 1
    }
}

def "stray"
{
    def Xform "a" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI"]
    )
    {
    }

    def Xform "b" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI"]
    )
    {
    }

    def PhysicsRevoluteJoint "j"
    {
        rel physics:body0 = </stray/a>
        rel physics:body1 = </stray/b>
    }
}

