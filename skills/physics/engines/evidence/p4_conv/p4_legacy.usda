#usda 1.0
(
    defaultPrim = "arm"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "arm" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
)
{
    def Xform "base" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:mass = 1
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cube "geom" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double size = 0.1
        }
    }

    def Xform "l1" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:mass = 1
        double3 xformOp:translate = (0, 0, 0.2)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cube "geom" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double size = 0.1
        }
    }

    def Xform "l2" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:mass = 1
        double3 xformOp:translate = (0, 0, 0.4)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cube "geom" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double size = 0.1
        }
    }

    def Xform "l3" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:mass = 1
        double3 xformOp:translate = (0, 0, 0.6)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cube "geom" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double size = 0.1
        }
    }

    def PhysicsFixedJoint "root_joint"
    {
        rel physics:body1 = </arm/base>
    }

    def PhysicsRevoluteJoint "j1" (
        prepend apiSchemas = ["PhysxJointAPI", "PhysicsDriveAPI:angular"]
    )
    {
        float drive:angular:physics:damping = 10
        float drive:angular:physics:stiffness = 100
        float drive:angular:physics:targetPosition = 0
        uniform token physics:axis = "Y"
        rel physics:body0 = </arm/base>
        rel physics:body1 = </arm/l1>
        point3f physics:localPos0 = (0, 0, 0.1)
        point3f physics:localPos1 = (0, 0, -0.1)
        float physics:lowerLimit = -90
        float physics:upperLimit = 90
    }

    def PhysicsRevoluteJoint "j2_nogain" (
        prepend apiSchemas = ["PhysxJointAPI", "PhysicsDriveAPI:angular"]
    )
    {
        float drive:angular:physics:damping = 0
        float drive:angular:physics:stiffness = 0
        float drive:angular:physics:targetPosition = 0
        uniform token physics:axis = "Y"
        rel physics:body0 = </arm/l1>
        rel physics:body1 = </arm/l2>
        point3f physics:localPos0 = (0, 0, 0.1)
        point3f physics:localPos1 = (0, 0, -0.1)
        float physics:lowerLimit = -90
        float physics:upperLimit = 90
    }

    def PhysicsRevoluteJoint "j3_mimic" (
        prepend apiSchemas = ["PhysxJointAPI", "PhysxMimicJointAPI:rotY"]
    )
    {
        uniform token physics:axis = "Y"
        rel physics:body0 = </arm/l2>
        rel physics:body1 = </arm/l3>
        point3f physics:localPos0 = (0, 0, 0.1)
        point3f physics:localPos1 = (0, 0, -0.1)
        float physics:lowerLimit = -90
        float physics:upperLimit = 90
        float physxMimicJoint:rotY:gearing = 1
        rel physxMimicJoint:rotY:referenceJoint = </arm/j1>
    }
}

